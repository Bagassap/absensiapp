generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GURU
}

enum NotificationType {
  ABSENSI
  SISTEM
}

enum StatusPasswordReset {
  PENDING
  SELESAI
}

enum StatusAbsensiKegiatan {
  HADIR
  IZIN
}

model User {
  id                         String   @id @default(cuid())
  nama                       String
  email                      String?  @unique
  loginId                    String?
  password                   String
  role                       Role
  isActive                   Boolean  @default(true)
  mustChangePassword         Boolean  @default(false)
  profileCompleted           Boolean  @default(false)
  // One-time escape hatch for changePassword()'s identity-verification step
  // (nama/tanggalLahir) — set by an admin who has already confirmed the
  // account owner's identity themselves (e.g. in person) when the stored
  // nama/tanggalLahir data is wrong or the guru can't otherwise pass it.
  bypassIdentityVerification Boolean  @default(false)
  // Path to the mandatory 1:1 profile photo (uploads/foto-profil/*), null
  // until the user completes /lengkapi-foto-profil. Applies to every role.
  fotoProfil                 String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  guru          Guru?
  notifications Notification[]

  passwordResetRequests   PasswordResetRequest[] @relation("PasswordResetRequestUser")
  processedPasswordResets PasswordResetRequest[] @relation("PasswordResetRequestProcessor")
  kegiatanDibuat          Kegiatan[]             @relation("KegiatanCreator")
  kegiatanRecurringDibuat KegiatanRecurring[]    @relation("KegiatanRecurringCreator")
  absensiDiverifikasi     AbsensiKegiatan[]      @relation("AbsensiVerifier")

  @@index([loginId])
  @@map("users")
}

model PasswordResetRequest {
  id              String              @id @default(cuid())
  userId          String?
  user            User?               @relation("PasswordResetRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  namaPengaju     String
  loginIdDiajukan String
  keterangan      String?
  status          StatusPasswordReset @default(PENDING)
  createdAt       DateTime            @default(now())
  processedAt     DateTime?
  processedById   String?
  processedBy     User?               @relation("PasswordResetRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("password_reset_requests")
}

// Kegiatan sekolah pada tanggal tertentu (mis. "Upacara", "Rapat Guru") —
// admin membuat satu per tanggal, masing-masing dengan jendela waktu absen
// sendiri. Menggantikan JadwalAbsenOverride lama (yang cuma punya SATU
// jendela hadir + SATU jendela pulang per hari) karena absensi sekarang
// terikat ke kegiatan spesifik, bukan jam datang/pulang harian.
//
// "Apel Pagi" dan "Piket Harian" adalah dua kegiatan berdiri (standing) yang
// selalu online setiap hari tanpa admin perlu membuatnya manual — lihat
// ensureStandingKegiatan() di AbsensiHarianService yang otomatis membuatkan
// baris untuk tanggal berjalan kalau belum ada. Kegiatan lain (Upacara,
// Rapat, dst) tetap harus disetel manual lewat "Tambah Kegiatan" seperti
// biasa.
model Kegiatan {
  id          String   @id @default(cuid())
  nama        String
  tanggal     String
  jamMulai    Int
  jamSelesai  Int
  keterangan  String?
  createdById String?
  createdBy   User?    @relation("KegiatanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Diisi kalau baris ini dibuat otomatis dari sebuah KegiatanRecurring
  // (lihat ensureRecurringKegiatan) — onDelete: SetNull supaya menghapus
  // aturan berulangnya tidak ikut menghapus riwayat kegiatan/absensi yang
  // sudah pernah terjadi dari aturan itu.
  recurringSourceId String?
  recurringSource   KegiatanRecurring? @relation(fields: [recurringSourceId], references: [id], onDelete: SetNull)

  absensi AbsensiKegiatan[]

  @@index([tanggal])
  @@map("kegiatan")
}

// Aturan kegiatan yang berulang tiap minggu pada hari tertentu (mis. "Rapat
// Guru" tiap Senin) — beda dengan STANDING_KEGIATAN (Apel Pagi/Piket Harian)
// yang hardcode tiap hari, ini didefinisikan admin lewat UI dan cuma aktif
// di hari yang dipilih. ensureRecurringKegiatan membuatkan baris Kegiatan
// sungguhan untuk tanggal yang sedang dilihat kalau harinya cocok dan belum
// ada instance-nya.
model KegiatanRecurring {
  id          String   @id @default(cuid())
  nama        String
  // Bisa lebih dari satu hari (atau ke-7 hari) per aturan — tiap elemen
  // "SENIN" | "SELASA" | "RABU" | "KAMIS" | "JUMAT" | "SABTU" | "MINGGU".
  // Tabelnya kecil (segelintir aturan), jadi tidak diberi index khusus —
  // ensureRecurringKegiatan cukup findMany lalu filter dengan `has` di JS/
  // where clause Prisma.
  hari        String[]
  jamMulai    Int
  jamSelesai  Int
  keterangan  String?
  createdById String?
  createdBy   User?    @relation("KegiatanRecurringCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances Kegiatan[]

  @@map("kegiatan_recurring")
}

model Guru {
  id     String  @id @default(cuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip    String? @unique
  noWa   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  absensiKegiatan AbsensiKegiatan[]
  jadwalPiket     JadwalPiket[]

  @@map("guru")
}

// Jadwal piket harian tendik per hari — 1 baris per (hari, guru), diisi dari
// "Jadwal_Piket_Tendik_2026-2027.xlsx". Menentukan otomatis di
// AbsensiHarianService: guru yang punya jadwal piket di hari itu hanya bisa
// absen "Piket Harian" (bukan "Apel Pagi"), dan sebaliknya guru yang tidak
// piket hari itu wajib absen "Apel Pagi". `lokasiTugas` ditampilkan sebagai
// keterangan personal di form absen piket guru ybs.
model JadwalPiket {
  id          String @id @default(cuid())
  hari        String // "SENIN" | "SELASA" | "RABU" | "KAMIS" | "JUMAT"
  guruId      String
  guru        Guru   @relation(fields: [guruId], references: [id], onDelete: Cascade)
  lokasiTugas String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hari, guruId])
  @@map("jadwal_piket")
}

// Absensi kegiatan milik guru sendiri — 1 baris per guru per kegiatan yang
// diikuti (bukan 1 per hari): seorang guru bisa absen beberapa kegiatan
// dalam sehari, masing-masing dengan foto selfie + lokasi + ttd sendiri.
model AbsensiKegiatan {
  id         String   @id @default(cuid())
  guruId     String
  guru       Guru     @relation(fields: [guruId], references: [id])
  kegiatanId String
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  waktuAbsen String
  lokasi     String
  foto       String
  ttd        String   @db.Text
  // Guru tetap wajib foto selfie + lokasi + ttd seperti biasa apa pun
  // statusnya — "Izin" di sini cuma menandai keterangan kehadirannya,
  // bukan jalur terpisah tanpa bukti kehadiran.
  status StatusAbsensiKegiatan @default(HADIR)

  // Admin wajib memverifikasi tiap absensi masuk — badge centang biru di UI
  // muncul kalau verified true. verifiedById disengaja SetNull (bukan
  // Cascade) supaya riwayat verifikasi tidak ikut hilang kalau akun admin
  // yang memverifikasi kelak dihapus.
  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("AbsensiVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  // Catatan dari ketenagaan (HR/admin) yang ditulis saat memverifikasi —
  // ditampilkan ke admin lain di tabel absensi dan memicu notifikasi ke
  // guru ybs. Ikut dikosongkan saat verifikasi dibatalkan (lihat
  // toggleVerifikasi), sama seperti verifiedAt/verifiedById.
  catatan String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guruId, kegiatanId])
  @@map("absensi_kegiatan")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(SISTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}
