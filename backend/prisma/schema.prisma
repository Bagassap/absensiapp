generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GURU
  SISWA
}

enum StatusPenempatan {
  AKTIF
  SELESAI
  BATAL
}

enum StatusIzin {
  PENDING
  DISETUJUI
  DITOLAK
}

enum StatusSiswa {
  AKTIF
  LULUS
}

enum NotificationType {
  PENGUMUMAN
  ABSENSI
  TUGAS
  MAGANG
  UKK
  SISTEM
}

enum StatusPasswordReset {
  PENDING
  SELESAI
}

model User {
  id                         String   @id @default(cuid())
  nama                       String
  email                      String?  @unique
  loginId                    String?
  password                   String
  role                       Role
  isActive                   Boolean  @default(true)
  mustChangePassword         Boolean  @default(false)
  profileCompleted           Boolean  @default(false)
  // One-time escape hatch for changePassword()'s identity-verification step
  // (nama/tanggalLahir) — set by an admin who has already confirmed the
  // account owner's identity themselves (e.g. in person) when the stored
  // nama/tanggalLahir data is wrong or the student can't otherwise pass it.
  // Consumed automatically the next time changePassword() succeeds.
  bypassIdentityVerification Boolean  @default(false)
  // Path to the mandatory 1:1 profile photo (uploads/foto-profil/*), null
  // until the user completes /lengkapi-foto-profil. Applies to every role.
  fotoProfil                 String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  siswa               Siswa?
  guru                Guru?
  pengumuman          Pengumuman[]
  komentarPengumuman  KomentarPengumuman[]
  diskusiUkk          DiskusiUKK[]
  notifications       Notification[]
  catatanSiswaDicatat CatatanSiswa[]
  materiDibuat        Materi[]
  tugasDibuat         Tugas[]

  passwordResetRequests   PasswordResetRequest[] @relation("PasswordResetRequestUser")
  processedPasswordResets PasswordResetRequest[] @relation("PasswordResetRequestProcessor")
  jadwalAbsenOverrides    JadwalAbsenOverride[]  @relation("JadwalAbsenOverrideCreator")

  @@index([loginId])
  @@map("users")
}

model PasswordResetRequest {
  id              String              @id @default(cuid())
  userId          String?
  user            User?               @relation("PasswordResetRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  namaPengaju     String
  loginIdDiajukan String
  keterangan      String?
  status          StatusPasswordReset @default(PENDING)
  createdAt       DateTime            @default(now())
  processedAt     DateTime?
  processedById   String?
  processedBy     User?               @relation("PasswordResetRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("password_reset_requests")
}

// Override jadwal jendela absen (jam buka/tutup Absen Datang & Absen Pulang)
// untuk SATU tanggal tertentu - menggantikan pola lama "tambah konstanta
// tanggal hardcode + deploy ulang" di absensi-harian.service.ts. Field yang
// null berarti "pakai jadwal normal hari itu" untuk batas tersebut; hanya
// batas yang benar-benar berubah yang perlu diisi (mis. cuma
// pulangStartMinutes untuk kasus "pulang lebih awal").
model JadwalAbsenOverride {
  id                 String   @id @default(cuid())
  tanggal            String   @unique
  hadirStartMinutes  Int?
  hadirEndMinutes    Int?
  pulangStartMinutes Int?
  pulangEndMinutes   Int?
  keterangan         String?
  createdById        String?
  createdBy          User?    @relation("JadwalAbsenOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tanggal])
  @@map("jadwal_absen_overrides")
}

model Siswa {
  id           String    @id @default(cuid())
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  nis          String    @unique
  nama         String?
  kelasId      String
  kelas        Kelas     @relation(fields: [kelasId], references: [id])
  jurusan      String?
  angkatan     Int
  jenisKelamin String?
  noHp         String?
  dukuh        String?
  rt           String?
  rw           String?
  desa         String?
  kecamatan    String?
  kabupaten    String?
  tempatLahir  String?
  tanggalLahir DateTime?
  namaOrtu     String?

  // AKTIF = siswa berjalan biasa. LULUS = sudah lulus (kelas XII naik jadi
  // alumni) — otomatis disembunyikan dari Data Siswa aktif, dan akun
  // login-nya (jika ada) dinonaktifkan. Riwayat (absensi/nilai/tugas dst)
  // tetap disimpan, tidak dihapus.
  status    StatusSiswa @default(AKTIF)
  lulusPada DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  penempatan        PenempatanMagang[]
  absensiMagang     AbsensiMagang[]
  izinMagang        IzinMagang[]
  laporDiriMagang   LaporDiriMagang[]
  laporanAkhirMagang LaporanAkhirMagang[]
  absensiUkk        AbsensiUjianUKK[]
  berkasJawaban     BerkasJawabanUKK[]
  nilaiUkk          NilaiUKK[]
  submisiProjectUkk SubmisiProjectUKK[]
  pesertaUkk        PesertaUKK[]
  absensiHarian     AbsensiHarian[]
  catatanSiswa      CatatanSiswa[]
  tugasSubmisi      TugasSubmisi[]

  @@map("siswa")
}

model Guru {
  id     String  @id @default(cuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip    String? @unique
  noWa   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kelasWali      Kelas[]
  bimbingan      PenempatanMagang[]
  izinDisetujui  IzinMagang[]
  soalUkk        SoalUKK[]
  nilaiUkk       NilaiUKK[]
  jadwalUjianUkk JadwalUjianUKK[]
  mapelDiampu    GuruMapel[]

  @@map("guru")
}

// Mata pelajaran yang diampu tiap guru — sumber data: mapel.xlsx (diimpor
// sekali via prisma/import-guru-mapel.ts). Dipakai untuk membatasi pilihan
// mapel saat guru membuat Materi/Tugas (lihat MateriService/TugasService).
model GuruMapel {
  id     String @id @default(cuid())
  guruId String
  guru   Guru   @relation(fields: [guruId], references: [id], onDelete: Cascade)
  nama   String

  createdAt DateTime @default(now())

  @@unique([guruId, nama])
  @@map("guru_mapel")
}

model Kelas {
  id              String   @id @default(cuid())
  nama            String   @unique
  waliKelasGuruId String?
  waliKelasGuru   Guru?    @relation(fields: [waliKelasGuruId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  siswa         Siswa[]
  absensiHarian AbsensiHarian[]
  materiList    Materi[]
  tugas         Tugas[]

  @@map("kelas")
}

model CatatanSiswa {
  id            String   @id @default(cuid())
  siswaId       String
  siswa         Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  dicatatOlehId String
  dicatatOleh   User     @relation(fields: [dicatatOlehId], references: [id])
  judul         String
  catatan       String   @db.Text
  poin          Int?
  tanggal       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catatan_siswa")
}

model AbsensiHarian {
  id         String  @id @default(cuid())
  siswaId    String
  siswa      Siswa   @relation(fields: [siswaId], references: [id])
  kelasId    String
  kelas      Kelas   @relation(fields: [kelasId], references: [id])
  tanggal    String
  status     String?
  waktuAbsen String?
  lokasi     String?
  foto       String?
  ttd        String? @db.Text
  catatan    String?

  waktuPulang   String?
  lokasiPulang  String?
  fotoPulang    String?
  ttdPulang     String? @db.Text
  catatanPulang String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siswaId, tanggal])
  @@map("absensi_harian")
}

model Pengumuman {
  id        String               @id @default(cuid())
  slug      String               @unique
  judul     String
  konten    String               @db.Text
  kategori  String               @default("Umum")
  isPinned  Boolean              @default(false)
  prioritas String               @default("NORMAL")
  authorId  String
  author    User                 @relation(fields: [authorId], references: [id])
  komentar  KomentarPengumuman[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pengumuman")
}

// Materi murni modul/dokumen (unduhan) — mode praktik kode dipindah ke Tugas.
// kelasId null berarti materi berlaku untuk semua kelas.
model Materi {
  id          String  @id @default(cuid())
  judul       String
  deskripsi   String? @db.Text
  mapel       String
  // Kelas target materi ini — kosong (tidak ada relasi) berarti "Semua Kelas".
  // Dulu relasi 1 kelas per materi (kelasId), sekarang bisa banyak kelas
  // sekaligus (lihat migrasi 20260821_materi_multi_kelas).
  kelasList   Kelas[]
  fileUrl     String?
  fileName    String?
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("materi")
}

enum StatusTugas {
  TERKIRIM
  DITERIMA
  REVISI
}

// Tugas independen dari Materi — di-scope langsung lewat mapel (teks bebas,
// sama seperti Materi.mapel) dan kelasId (null berarti berlaku untuk semua
// kelas). deadline dipakai utnuk membedakan tugas Aktif/Selesai di tampilan,
// mengikuti pola tahapan_ukk pada fitur Jadwal & Soal UKK.
// tipe: "SUBMIT" (guru kirim PDF, siswa unggah balik file jawaban tanpa mode
// pengerjaan apapun), "PRAKTIK" (siswa mengetik HTML/CSS/JS langsung di
// canvas LMS — starterHtml/Css/Js adalah kode awal), "PILIHAN_GANDA" (soal
// pilihan ganda A-D, dikerjakan & bisa diperiksa otomatis via TugasSoal),
// atau "ESSAY" (soal esai, siswa mengetik jawaban teks per soal).
model Tugas {
  id          String   @id @default(cuid())
  mapel       String
  kelasId     String?
  kelas       Kelas?   @relation(fields: [kelasId], references: [id])
  judul       String
  deskripsi   String?  @db.Text
  deadline    DateTime
  tipe        String   @default("SUBMIT")
  fileUrl     String?
  fileName    String?
  starterHtml String?  @db.Text
  starterCss  String?  @db.Text
  starterJs   String?  @db.Text
  // Durasi pengerjaan (menit) untuk mode lockdown — wajib diisi FE untuk
  // PILIHAN_GANDA/ESSAY, opsional untuk PRAKTIK, diabaikan untuk SUBMIT.
  durasiMenit Int?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submisi TugasSubmisi[]
  soal    TugasSoal[]

  @@map("tugas")
}

// Satu baris per soal pada tugas tipe PILIHAN_GANDA/ESSAY. Untuk pilihan
// ganda, pilihanA-D + jawabanBenar diisi; untuk esai, hanya pertanyaan yang
// dipakai. jawabanBenar tidak pernah dikirim ke siswa sebelum ia submit.
model TugasSoal {
  id           String  @id @default(cuid())
  tugasId      String
  tugas        Tugas   @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  urutan       Int     @default(0)
  pertanyaan   String  @db.Text
  pilihanA     String?
  pilihanB     String?
  pilihanC     String?
  pilihanD     String?
  jawabanBenar String?

  jawaban TugasJawaban[]

  @@map("tugas_soal")
}

// Submisi tugas tipe SUBMIT mengisi fileUrl/fileName; tipe PRAKTIK mengisi
// submittedHtml/Css/Js; tipe PILIHAN_GANDA/ESSAY mengisi relasi jawaban
// (satu TugasJawaban per TugasSoal).
model TugasSubmisi {
  id            String      @id @default(cuid())
  tugasId       String
  tugas         Tugas       @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  siswaId       String
  siswa         Siswa       @relation(fields: [siswaId], references: [id])
  fileUrl       String?
  fileName      String?
  submittedHtml String?     @db.Text
  submittedCss  String?     @db.Text
  submittedJs   String?     @db.Text
  catatan       String?
  pesanRevisi   String?
  status        StatusTugas @default(TERKIRIM)
  // Nilai otomatis 0-100, dibulatkan — hanya diisi untuk tugas PILIHAN_GANDA
  // (dihitung server-side saat submit). Tipe lain (ESSAY dst.) tetap null
  // karena butuh penilaian manual guru.
  nilai         Int?
  submittedAt   DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Lockdown/exam-mode tracking untuk tugas PRAKTIK/PILIHAN_GANDA/ESSAY —
  // maksimal 2 percobaan (jumlahPercobaan bertambah setiap kali siswa
  // membuka lembar pengerjaan, bukan setiap submit). Begitu terkunci=true,
  // siswa tidak bisa membuka lembar pengerjaan lagi kecuali di-reset guru/
  // admin. waktuMulai/deadlineWaktu dihitung & disimpan server-side supaya
  // timer tidak bisa dimanipulasi dari sisi klien.
  jumlahPercobaan Int      @default(0)
  terkunci        Boolean  @default(false)
  dipaksaKeluar   Boolean  @default(false)
  waktuMulai      DateTime?
  deadlineWaktu   DateTime?

  jawaban TugasJawaban[]

  @@unique([tugasId, siswaId])
  @@map("tugas_submisi")
}

model TugasJawaban {
  id             String       @id @default(cuid())
  submisiId      String
  submisi        TugasSubmisi @relation(fields: [submisiId], references: [id], onDelete: Cascade)
  soalId         String
  soal           TugasSoal    @relation(fields: [soalId], references: [id], onDelete: Cascade)
  jawabanPilihan String?
  jawabanEssay   String?      @db.Text

  @@unique([submisiId, soalId])
  @@map("tugas_jawaban")
}

model KomentarPengumuman {
  id           String               @id @default(cuid())
  pengumumanId String
  pengumuman   Pengumuman           @relation(fields: [pengumumanId], references: [id], onDelete: Cascade)
  authorId     String
  author       User                 @relation(fields: [authorId], references: [id])
  konten       String               @db.Text
  parentId     String?
  parent       KomentarPengumuman?  @relation("KomentarReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      KomentarPengumuman[] @relation("KomentarReplies")
  createdAt    DateTime             @default(now())

  @@map("komentar_pengumuman")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(SISTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model TempatMagang {
  id          String  @id @default(cuid())
  namaTempat  String
  alamat      String
  kontak      String?
  bidangUsaha String?
  kuota       Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  penempatan   PenempatanMagang[]
  absensi      AbsensiMagang[]
  laporDiri    LaporDiriMagang[]
  laporanAkhir LaporanAkhirMagang[]

  @@map("tempat_magang")
}

model PenempatanMagang {
  id               String           @id @default(cuid())
  siswaId          String
  siswa            Siswa            @relation(fields: [siswaId], references: [id])
  tempatMagangId   String
  tempatMagang     TempatMagang     @relation(fields: [tempatMagangId], references: [id])
  guruPembimbingId String
  guruPembimbing   Guru             @relation(fields: [guruPembimbingId], references: [id])
  tanggalMulai     DateTime         @db.Date
  tanggalSelesai   DateTime?        @db.Date
  status           StatusPenempatan @default(AKTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  absensi      AbsensiMagang[]
  izin         IzinMagang[]
  laporDiri    LaporDiriMagang[]
  laporanAkhir LaporanAkhirMagang?

  @@unique([siswaId, tempatMagangId])
  @@map("penempatan_magang")
}

// Laporan bulanan wajib PKL — 1 file (PDF/PPT presentasi) per siswa per
// bulan selama masa penempatan aktif, bukan per hari seperti AbsensiMagang.
model LaporDiriMagang {
  id             String           @id @default(cuid())
  siswaId        String
  siswa          Siswa            @relation(fields: [siswaId], references: [id])
  penempatanId   String
  penempatan     PenempatanMagang @relation(fields: [penempatanId], references: [id])
  tempatMagangId String
  tempatMagang   TempatMagang     @relation(fields: [tempatMagangId], references: [id])
  // Format "YYYY-MM" — periode bulan laporan ini, bukan tanggal upload.
  periode        String
  fileUrl        String
  fileName       String
  catatan        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([penempatanId, periode])
  @@map("lapor_diri_magang")
}

enum StatusLaporanAkhirMagang {
  TERKIRIM
  DITERIMA
  REVISI
}

// Laporan akhir PKL — 1 file (PDF/Word/PPT) per penempatan, dikirim sekali
// lalu direview admin/guru (Terima/Revisi). Beda dari LaporDiriMagang yang
// bulanan & tanpa review — ini satu dokumen final yang perlu di-acc.
model LaporanAkhirMagang {
  id             String                    @id @default(cuid())
  siswaId        String
  siswa          Siswa                     @relation(fields: [siswaId], references: [id])
  penempatanId   String                    @unique
  penempatan     PenempatanMagang          @relation(fields: [penempatanId], references: [id])
  tempatMagangId String
  tempatMagang   TempatMagang              @relation(fields: [tempatMagangId], references: [id])
  fileUrl        String
  fileName       String
  catatan        String?
  pesanRevisi    String?
  status         StatusLaporanAkhirMagang  @default(TERKIRIM)

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("laporan_akhir_magang")
}

// Sengaja dibuat semirip mungkin dengan AbsensiHarian (1 baris per siswa per
// hari, status HADIR/IZIN/SAKIT/ALPA + pasangan field *Pulang) supaya pola UI
// & komponen frontend-nya bisa dipakai ulang - bedanya di-scope oleh
// TempatMagang/PenempatanMagang, bukan Kelas.
model AbsensiMagang {
  id             String           @id @default(cuid())
  siswaId        String
  siswa          Siswa            @relation(fields: [siswaId], references: [id])
  penempatanId   String
  penempatan     PenempatanMagang @relation(fields: [penempatanId], references: [id])
  tempatMagangId String
  tempatMagang   TempatMagang     @relation(fields: [tempatMagangId], references: [id])
  tanggal        String
  status         String?
  waktuAbsen     String?
  lokasi         String?
  foto           String?
  ttd            String?          @db.Text
  catatan        String?

  waktuPulang   String?
  lokasiPulang  String?
  fotoPulang    String?
  ttdPulang     String? @db.Text
  catatanPulang String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([penempatanId, tanggal])
  @@map("absensi_magang")
}

model IzinMagang {
  id            String           @id @default(cuid())
  penempatanId  String
  penempatan    PenempatanMagang @relation(fields: [penempatanId], references: [id])
  siswaId       String
  siswa         Siswa            @relation(fields: [siswaId], references: [id])
  tanggal       DateTime         @db.Date
  alasan        String
  buktiUrl      String?
  status        StatusIzin       @default(PENDING)
  diperiksaOleh String?
  guruPemeriksa Guru?            @relation(fields: [diperiksaOleh], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([penempatanId, tanggal])
  @@map("izin_magang")
}

enum TipeUKK {
  INTERNAL
  EKSTERNAL
  REVISI
}

enum StatusSubmisiUKK {
  TERKIRIM
  DITERIMA
  REVISI
}

model TahapanUKK {
  id         String   @id @default(cuid())
  tipe       TipeUKK
  hariKe     Int
  judul      String
  tanggal    DateTime @db.Date
  jamMulai   String
  jamSelesai String
  lokasi     String
  penguji    String?
  keterangan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  soal    SoalTahapanUKK[]
  peserta PesertaUKK[]

  @@map("tahapan_ukk")
}

model PesertaUKK {
  id        String     @id @default(cuid())
  siswaId   String
  siswa     Siswa      @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  tahapanId String
  tahapan   TahapanUKK @relation(fields: [tahapanId], references: [id], onDelete: Cascade)

  @@unique([siswaId, tahapanId])
  @@map("peserta_ukk")
}

model SoalTahapanUKK {
  id        String     @id @default(cuid())
  tahapanId String
  tahapan   TahapanUKK @relation(fields: [tahapanId], references: [id], onDelete: Cascade)
  judul     String
  deskripsi String?
  fileUrl   String
  fileName  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  submisi SubmisiProjectUKK[]

  @@map("soal_tahapan_ukk")
}

model SubmisiProjectUKK {
  id          String           @id @default(cuid())
  soalId      String
  soal        SoalTahapanUKK   @relation(fields: [soalId], references: [id], onDelete: Cascade)
  siswaId     String
  siswa       Siswa            @relation(fields: [siswaId], references: [id])
  fileUrl     String
  fileName    String
  catatan     String?
  pesanRevisi String?
  status      StatusSubmisiUKK @default(TERKIRIM)
  submittedAt DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([soalId, siswaId])
  @@map("submisi_project_ukk")
}

model DiskusiUKK {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  konten    String       @db.Text
  parentId  String?
  parent    DiskusiUKK?  @relation("DiskusiReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DiskusiUKK[] @relation("DiskusiReplies")
  createdAt DateTime     @default(now())

  @@map("diskusi_ukk")
}

model JadwalUjianUKK {
  id         String   @id @default(cuid())
  guruId     String
  guru       Guru     @relation(fields: [guruId], references: [id])
  judul      String
  kelas      String
  tanggal    DateTime @db.Date
  jamMulai   String
  jamSelesai String
  ruangan    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  absensi AbsensiUjianUKK[]
  soal    SoalUKK[]
  nilai   NilaiUKK[]

  @@map("jadwal_ujian_ukk")
}

model AbsensiUjianUKK {
  id             String         @id @default(cuid())
  jadwalId       String
  jadwal         JadwalUjianUKK @relation(fields: [jadwalId], references: [id])
  siswaId        String
  siswa          Siswa          @relation(fields: [siswaId], references: [id])
  waktuMasuk     DateTime?
  waktuKeluar    DateTime?
  tandaTanganUrl String?

  createdAt DateTime @default(now())

  @@unique([jadwalId, siswaId])
  @@map("absensi_ujian_ukk")
}

model SoalUKK {
  id       String         @id @default(cuid())
  jadwalId String
  jadwal   JadwalUjianUKK @relation(fields: [jadwalId], references: [id])
  guruId   String
  guru     Guru           @relation(fields: [guruId], references: [id])
  judul    String
  fileUrl  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  berkasJawaban BerkasJawabanUKK[]

  @@unique([jadwalId])
  @@map("soal_ukk")
}

model BerkasJawabanUKK {
  id         String   @id @default(cuid())
  soalId     String
  soal       SoalUKK  @relation(fields: [soalId], references: [id])
  siswaId    String
  siswa      Siswa    @relation(fields: [siswaId], references: [id])
  fileUrl    String
  uploadedAt DateTime @default(now())

  @@unique([soalId, siswaId])
  @@map("berkas_jawaban_ukk")
}

model NilaiUKK {
  id       String         @id @default(cuid())
  jadwalId String
  jadwal   JadwalUjianUKK @relation(fields: [jadwalId], references: [id])
  siswaId  String
  siswa    Siswa          @relation(fields: [siswaId], references: [id])
  guruId   String
  guru     Guru           @relation(fields: [guruId], references: [id])
  nilai    Float
  catatan  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jadwalId, siswaId])
  @@map("nilai_ukk")
}
